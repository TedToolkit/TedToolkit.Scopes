<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="CodeAnalysis.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="NugetPackage.props" Sdk="TedToolkit.Build.Sdk"/>
  <Import Project="AlmostAllFrameworks.props" Sdk="TedToolkit.Build.Sdk"/>
  <PropertyGroup>
    <Title>Scopes</Title>
    <Description>The Scopes.</Description>
    <NoWarn>$(NoWarn);CA1000</NoWarn>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\TedToolkit.Scopes.Analyzers\bin\$(Configuration)\netstandard2.0\TedToolkit.Scopes.Analyzers.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
    <PackageReference Include="TedToolkit.Refly" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../.agents/skills/choose-ambient-scope-lifetimes/**/*"
          Pack="true" PackagePath="skills/choose-ambient-scope-lifetimes/" />
  </ItemGroup>
</Project>
